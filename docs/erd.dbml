// Love Map-tually - ERD v3.2 (dbdiagram.io / DBML)
// 기준: PRD v6.1 (UC-08 월간 리포트 반영) + 팀원 10테이블 SQL(2026-09-03) 검토 반영
//
// v3.2에서 바뀐 것 - 월간 리포트(UC-08, 유료)가 쓸 자리를 채웁니다 (15개 → 18개)
//   1. relation_groups.plan 추가 - FREE / PREMIUM. 리포트 생성 권한은 사람이 아니라 그룹에 걸립니다
//      한 명이 결제하면 둘 다 봅니다. 구독 단위가 그룹이라 플랜도 그룹 컬럼입니다
//   2. monthly_reports 추가 - 그룹의 한 달 리포트 한 편. UQ(group_id, report_month)로 월 1회입니다
//      status를 두는 것은 D-14(상태 컬럼을 두지 않는다)의 예외입니다. 추천과 같은 2단계 비동기라
//      recommendation_requests.status와 같은 모양으로 맞췄습니다
//      prompt_tokens / completion_tokens는 응답 usage 실측값이고 원가 계산의 근거입니다
//      content는 JSONB - 리포트 출력 스키마가 고정돼 있어 컬럼으로 펼치지 않고 통째로 둡니다
//   3. subscriptions 추가 - Mock 결제 기록. 언제부터 유료였는지가 없으면 환불·분쟁 대응이 불가합니다
//      실제 PG 연동은 비목표이고 payment_ref에 Mock 승인 번호가 들어갑니다
//
// v3.1에서 바뀐 것 - 협업 필터링이 쓸 테이블 하나를 채웁니다
//   PRD가 place_similarity를 전제하는데 ERD에 정의가 없어 비어 있던 자리입니다.
//   1. place_similarity 추가 - 장소 대 장소 피어슨 유사도의 사전 계산 결과
//      추천 요청 때는 조회만 합니다. 계산은 새벽 배치(3일 범위에서는 시드)가 합니다
//   2. 암묵적 피드백 테이블은 넣지 않았습니다
//      조회·체류 같은 이벤트를 수집하는 코드가 이번 범위에 없어 빈 테이블이 됩니다.
//      협업 필터링은 reviews.rating만으로 돌고, 이벤트 수집은 다음 단계로 미룹니다
//   3. reviews에 tag_status 추가 - API가 응답에 내려주던 값의 저장 자리가 없었습니다
//      COMPLETED는 review_tags 유무로 유추되지만 PENDING과 FAILED는 구분이 안 됩니다.
//      추천 쪽 recommendation_requests.status와 같은 역할이고 모양도 맞췄습니다
//   4. tags는 33행 고정을 유지합니다
//      사전 밖 표현은 unmatched_tag_logs에 쌓아 두고, 사전 확장은 별도 판단 사안입니다.
//      그래서 집계 테이블에 사전 버전 컬럼을 두지 않습니다
//
// v3에서 바뀐 것 - 관계 그룹을 N명으로 엽니다
//   MVP 시연은 커플 2인으로만 하되 스키마는 가족·친구까지 수용합니다.
//   1. group_type에 FRIENDS 추가, 구성원 2명 제한 트리거 삭제
//   2. place_label을 카운트 기반으로 재정의 (ALL_LIKED / MIXED / ON_HOLD)
//      분모는 그룹 인원이 아니라 "리뷰를 쓴 구성원 수"입니다
//   3. group_places에 liked_count / reviewed_count - 5명 중 4명을 화면에 보여 주려면 필요합니다
//   4. 초대 코드를 1회용에서 다회용으로 (max_uses / use_count)
//      used_by_user_id·used_at 삭제. 다회용에서는 값이 여러 개라 컬럼에 담기지 않습니다
//   5. relation_groups.name 추가 - 한 사람이 그룹 여럿을 가지면 구분할 이름이 필요합니다
//   6. connected_at 삭제 - "두 번째 구성원 합류 시각"은 2인 전용 정의입니다
//   7. group_members에 role / left_at - N명이면 권한과 탈퇴가 실제 문제가 됩니다
//   8. 모든 테이블의 PK를 대리키로 통일. 자연키는 UNIQUE 제약으로 따로 표현합니다
//      연결 테이블인데 group_places는 대리키, review_tags는 복합키여서 기준이 섞여 있었습니다
//   9. 장소 쪽 집계를 만족도가 아니라 사실로 (fact_high_count / fact_low_count)
//      만족도만 저장하면 매워서 좋았다와 안 매워서 좋았다가 같은 값이 되어 가게 사실이 무너집니다
//  10. HIGH/LOW를 좋고 나쁨이 아니라 축의 양 끝으로 정의하고 끝 이름을 사전에 적습니다
//      맵기 HIGH=매움, 웨이팅 HIGH=김, 야외석 HIGH=있음. 33개 태그에 모두 적용됩니다
//      AI는 HIGH/LOW가 아니라 사전 라벨로 답하고 서버가 코드로 변환합니다
//  11. polarity(만족했나)를 없애고 AI가 답을 두 개 주게 합니다
//      fact_value 가게가 어느 쪽인가 / want_value 이 사람은 어느 쪽을 원하는가
//      뒤집기·유도·태그 유형 구분이 전부 사라지고 두 값이 각자의 표로 그대로 들어갑니다
//      만족 여부는 두 값이 같은지로 읽히므로 따로 저장하지 않습니다
//  12. reviews에 with_group_id - 이 방문을 누구와 했는가
//      그룹 페이지도 이 값으로 조회합니다. review_shares 연결 테이블은 삭제했습니다
//      같은 리뷰를 여러 그룹에 보여 줄 일이 제품에 없어 두 질문의 답이 항상 같았습니다
//  13. 추천을 저장합니다 - recommendation_requests / recommendations 두 테이블
//      LLM이 2~5초 걸리므로 요청을 먼저 만들고(PENDING) 결과를 나중에 조회합니다
//      candidate_count를 남겨 SQL이 몇 곳을 넘겼는지 시연에서 보일 수 있습니다
//
// v2에서 이어받은 것
//   리뷰는 개인 소유. 그룹에는 with_group_id로 이어집니다 (PRD 5장)
//   집계 캐시 3종: place_tags / user_tags / group_places
//   모든 FK와 자연키에 not null (PostgreSQL UNIQUE는 NULL 중복을 허용합니다)
//
// dbdiagram이 내보내지 않는 것 - 익스포트 후 손으로 추가합니다
//   CHECK (rating BETWEEN 1 AND 5)
//   CHECK (price_band BETWEEN 1 AND 4)
//   CHECK (use_count <= max_uses)
//   CHECK (liked_count <= reviewed_count)
//   updated_at 자동 갱신 트리거
//
// 애플리케이션이 담당하는 규칙 - DB 제약으로 표현하지 않습니다
//   COUPLE 타입은 구성원 2명, 사용자당 1개 (409). FAMILY·FRIENDS는 제한 없음
//   탈퇴 후 재가입은 같은 group_members 행의 left_at을 비워 되살립니다
//   리포트 생성은 PREMIUM 그룹만 (402). 그 달 리뷰 0건이면 만들지 않음 (422). 플랜 검사는 서비스 계층 한 곳
//   과거 리포트 열람은 플랜과 무관하게 구성원이면 가능 - 이미 만든 것을 다시 잠그지 않습니다

Project love_maptually {
  database_type: 'PostgreSQL'
  Note: 'AI 취향 기반 장소 데이터베이스. 리뷰는 개인이 소유하고 함께 간 그룹에 이어집니다. MVP는 커플, 스키마는 가족·친구까지 수용합니다.'
}

// ─────────────────────────────────────────────
// 열거형
// ─────────────────────────────────────────────

// 그룹의 종류. MVP 시연은 COUPLE만 시드하고 나머지는 스키마로만 열어 둡니다
Enum group_type {
  COUPLE
  FAMILY
  FRIENDS
}

// 그룹 안에서의 권한. OWNER는 그룹을 만든 사람이고 초대와 강제 탈퇴를 할 수 있습니다
Enum member_role {
  OWNER
  MEMBER
}

// 초대 코드의 상태. 다회용이므로 수락됨이라는 상태는 두지 않습니다
Enum invite_status {
  ACTIVE
  EXPIRED
  REVOKED
}

// 속성 축의 양 끝. HIGH와 LOW가 각 태그에서 무슨 뜻인지는 tags가 정의합니다
// 웨이팅 HIGH는 길었다는 뜻이고 맵기 HIGH는 매웠다는 뜻입니다. 좋고 나쁨이 아닙니다
Enum attr_level {
  HIGH
  LOW
}

// 태그 사전의 5축. ATMOSPHERE 분위기·공간 10 / TASTE 맛·메뉴 7
// CONVENIENCE 이용·편의 7 / PRICE 가격 2 / PURPOSE 상황·목적 7 = 고정 33행
// 소음은 조용함과 중복이라, 가격대는 places.price_band와 중복이라 뺐습니다
Enum tag_axis {
  ATMOSPHERE
  TASTE
  CONVENIENCE
  PRICE
  PURPOSE
}

// 추천 요청의 처리 상태. 순위 계산과 이유 생성이 끝나면 COMPLETED입니다
Enum rec_status {
  PENDING
  COMPLETED
  FAILED
}

// 리뷰의 태그 추출 상태. AI-1이 느릴 수 있어 리뷰를 먼저 저장하고 나중에 채웁니다
// COMPLETED만 review_tags 유무로 유추할 수 있고 PENDING과 FAILED는 구분이 안 되므로 저장합니다
Enum tag_status {
  PENDING
  COMPLETED
  FAILED
}

// 추천 근거가 어디서 왔는가. 우리 그룹의 기록인가 다른 그룹의 기록인가
// LLM이 정하지 않고 후보를 모은 SQL이 정해 실어 보냈다 되받습니다
Enum rec_basis {
  OWN
  OTHERS
}

// 월간 리포트의 생성 상태. 집계 → LLM 호출 → 검증·저장의 2단계 비동기라 rec_status와 같은 모양입니다
// FAILED는 완성본이 아닙니다. 유료 기능이라 템플릿으로 채우지 않고 재시도로 같은 행을 갱신합니다
Enum report_status {
  PENDING
  COMPLETED
  FAILED
}

// 그룹이 이 장소를 어떻게 평가했는가. 분모는 그룹 인원이 아니라 리뷰를 쓴 구성원 수입니다.
// ALL_LIKED 쓴 사람 전원이 4점 이상 / MIXED 갈림 / ON_HOLD 아무도 4점 이상이 아님
// 2인 그룹의 ONE_SIDED가 MIXED에 흡수됩니다
Enum place_label {
  ALL_LIKED
  MIXED
  ON_HOLD
}

// ─────────────────────────────────────────────
// 01 사용자와 그룹
// ─────────────────────────────────────────────

Table users {
  user_id       bigint       [pk, increment, note: '사용자 식별자. 취향 집계와 리뷰 소유권이 모두 이 값에 걸립니다']
  email         varchar(255) [not null, unique, note: '로그인 아이디를 겸합니다. not null이라야 UNIQUE가 실제로 중복을 막습니다']
  password_hash varchar(255) [not null, note: 'BCrypt 해시. 평문 비밀번호는 저장하지 않습니다']
  nickname      varchar(50)  [not null, note: '그룹 화면에서 누구의 리뷰인지 구분하는 표시 이름']
  created_at    timestamptz  [not null, default: `now()`, note: '가입 시각']
  updated_at    timestamptz  [not null, default: `now()`, note: '프로필 최종 수정 시각. 트리거로 갱신합니다']

  Note: '개인 계정. 취향은 그룹이 아니라 이 단위로 쌓입니다'
}

Table relation_groups {
  group_id   bigint      [pk, increment, note: '그룹 식별자. 리뷰·지도·라벨이 이 값을 기준으로 묶입니다']
  group_type group_type  [not null, default: 'COUPLE', note: '그룹의 종류. MVP는 COUPLE만 쓰고 FAMILY·FRIENDS는 확장 대비입니다']
  name       varchar(50) [note: '그룹 이름. 한 사람이 그룹 여럿을 가질 때 구분합니다. 커플은 하나뿐이라 NULL을 허용합니다']
  plan       varchar(10) [not null, default: 'FREE', note: '요금제. FREE / PREMIUM. 월간 리포트 생성은 PREMIUM만 가능합니다. 구독 단위가 그룹이라 사람이 아니라 여기에 둡니다. 현재 값이고 이력은 subscriptions에 있습니다']
  created_at timestamptz [not null, default: `now()`, note: '그룹이 만들어진 시각']

  Note: '커플·가족·친구를 담는 관계 그룹. 인원 제한을 두지 않으므로 라벨은 카운트로 판정합니다. plan은 현재 요금제의 캐시이고 변경 이력은 subscriptions가 갖습니다'
}

Table group_members {
  group_member_id bigint      [pk, increment, note: '구성원 행 식별자']
  group_id        bigint      [not null, note: '소속 그룹. FK relation_groups.group_id']
  user_id         bigint      [not null, note: '구성원 사용자. FK users.user_id']
  role            member_role [not null, default: 'MEMBER', note: '그룹 내 권한. 그룹을 만든 사람이 OWNER입니다']
  joined_at       timestamptz [not null, default: `now()`, note: '합류 시각. 어떤 코드로 들어왔는지는 추적하지 않습니다']
  left_at         timestamptz [note: '탈퇴 시각. NULL이면 현재 구성원입니다. 재가입 시 이 값을 비워 되살립니다']

  Indexes {
    (group_id, user_id) [unique, name: 'uq_group_members_pair']
    user_id [name: 'ix_group_members_user']
  }

  Note: '사용자와 그룹의 N대N 연결. 행을 지우지 않고 left_at으로 남기므로 지난 구성원이 남긴 리뷰가 살아 있습니다'
}

Table invite_codes {
  invite_code_id  bigint        [pk, increment, note: '초대 코드 행 식별자']
  code            varchar(16)   [not null, unique, note: '상대에게 전달하는 코드 문자열. 조회 키이므로 UNIQUE입니다']
  group_id        bigint        [not null, note: '초대 대상 그룹. 그룹을 먼저 만들고 코드를 발급합니다. FK relation_groups.group_id']
  inviter_user_id bigint        [not null, note: '발급자. 누가 부른 코드인지 남깁니다. FK users.user_id']
  status          invite_status [not null, default: 'ACTIVE', note: '코드의 현재 상태. 만료·취소 코드를 걸러 내는 기준입니다']
  max_uses        integer       [not null, default: 1, note: '최대 사용 횟수. 커플은 1, 가족·친구 그룹은 인원수만큼 열어 둡니다']
  use_count       integer       [not null, default: 0, note: '지금까지 수락된 횟수. max_uses에 도달하면 더 받지 않습니다']
  expires_at      timestamptz   [not null, note: '만료 시각. UC-01 예외 흐름의 판정 기준입니다']
  created_at      timestamptz   [not null, default: `now()`, note: '발급 시각']

  Indexes {
    group_id [name: 'ix_invite_codes_group']
    inviter_user_id [name: 'ix_invite_codes_inviter']
  }

  Note: '다회용 초대 코드. 수락 시각과 수락자는 group_members에 남으므로 여기에 중복해서 두지 않습니다'
}

// ─────────────────────────────────────────────
// 02 장소와 리뷰
// ─────────────────────────────────────────────

Table places {
  place_id          bigint        [pk, increment, note: '내부 장소 식별자. 외부 ID를 PK로 쓰지 않습니다']
  provider          varchar(20)   [not null, note: '장소 정보의 출처. 현재는 KAKAO 하나입니다']
  provider_place_id varchar(64)   [not null, note: '출처가 부여한 원본 ID. provider와 짝지어 중복 등록을 막습니다']
  name              varchar(200)  [not null, note: '장소 이름. 지도 핀과 추천 결과에 노출됩니다']
  address           varchar(300)  [not null, note: '전체 주소 문자열. 화면 표시용입니다']
  region            varchar(50)   [not null, note: '질의 해석 규칙이 뽑아낸 region으로 후보를 거르는 컬럼. 인덱스가 걸립니다']
  category          varchar(50)   [not null, note: '카페·식당 등 업종. 태그 축(tags.axis)과는 다른 개념입니다']
  price_band        smallint      [note: '1 저렴 ~ 4 비쌈. 질의 해석 규칙이 읽은 budget으로 거르는 대상입니다']
  latitude          numeric(10,7) [not null, note: '위도. 지도 핀 좌표입니다']
  longitude         numeric(10,7) [not null, note: '경도. 지도 핀 좌표입니다']
  created_at        timestamptz   [not null, default: `now()`, note: '이 장소가 처음 저장된 시각']

  Indexes {
    (provider, provider_place_id) [unique, name: 'uq_places_provider']
    region [name: 'ix_places_region']
  }

  Note: '외부 지도 API에서 가져와 캐시하는 장소 원장. 중복 등록 판단은 UNIQUE 제약이 담당합니다'
}

Table reviews {
  review_id     bigint      [pk, increment, note: '리뷰 식별자']
  user_id       bigint      [not null, note: '작성자이자 소유자. 그룹이 아니라 개인에게 귀속됩니다. FK users.user_id']
  place_id      bigint      [not null, note: '리뷰 대상 장소. FK places.place_id']
  visited_on    date        [not null, note: '방문 날짜. visits 테이블을 없앤 대신 구성원들의 리뷰를 짝짓는 키입니다']
  with_group_id bigint      [note: '이 방문을 함께한 그룹. 혼자 갔거나 밝히지 않으면 NULL. 그룹 페이지 조회와 관계별 통계가 모두 이 값을 씁니다. FK relation_groups.group_id']
  rating        smallint    [not null, note: '별점 1~5 정수. 4점 이상이 라벨 판정의 경계입니다']
  content       text        [not null, note: '자유 문장 리뷰. AI-1이 이 문장에서 태그를 뽑아냅니다']
  tag_status    tag_status  [not null, default: 'PENDING', note: '태그 추출 상태. API 응답의 tagStatus가 이 값입니다. Mock은 즉시 COMPLETED, 실제 LLM은 PENDING으로 저장했다가 채웁니다. 실패해도 리뷰는 남으므로 FAILED가 별도 상태입니다']
  created_at    timestamptz [not null, default: `now()`, note: '작성 시각']
  updated_at    timestamptz [not null, default: `now()`, note: '수정 시각. 수정되면 태그를 다시 뽑아야 합니다']

  Indexes {
    (user_id, place_id, visited_on) [unique, name: 'uq_reviews_visit']
    place_id [name: 'ix_reviews_place']
    with_group_id [name: 'ix_reviews_with_group']
  }

  Note: '개인이 소유하는 리뷰. UQ가 없으면 같은 방문에 리뷰가 여러 건 들어가 409를 막을 수 없고 라벨 계산이 흔들립니다'
}
Table group_places {
  group_place_id   bigint      [pk, increment, note: '그룹 장소 행 식별자']
  group_id         bigint      [not null, note: '이 장소를 담은 그룹. FK relation_groups.group_id']
  place_id         bigint      [not null, note: '지도에 올린 장소. FK places.place_id']
  added_by_user_id bigint      [not null, note: '등록한 사람. 누가 담았는지 화면에 표시합니다. FK users.user_id']
  label            place_label [note: '이 그룹과 함께 간 리뷰로 계산한 평가 결과. NULL이면 장소만 등록되고 아직 리뷰가 없는 상태입니다']
  reviewed_count   integer     [not null, default: 0, note: '이 그룹과 함께 가서 리뷰를 쓴 구성원 수. 라벨 판정의 분모입니다. 사람 1명당 1표라 재방문해도 늘지 않습니다']
  liked_count      integer     [not null, default: 0, note: '그중 최신 방문에 4점 이상을 준 구성원 수. 분자입니다']
  label_updated_at timestamptz [note: '라벨과 두 카운트를 마지막으로 다시 센 시각. place_tags와 같은 이유로 더하지 않고 다시 셉니다']
  created_at       timestamptz [not null, default: `now()`, note: '지도에 등록한 시각. 리뷰보다 먼저 등록될 수 있습니다']

  Indexes {
    (group_id, place_id) [unique, name: 'uq_group_places_pair']
    place_id [name: 'ix_group_places_place']
  }

  Note: '그룹 지도의 핀 하나. 라벨의 단위는 방문이 아니라 장소입니다. 장소 등록과 리뷰 작성이 별개 단계라 label이 NULL인 상태가 존재하고, 5명 중 4명 같은 표시는 두 카운트로 만듭니다'
}

// ─────────────────────────────────────────────
// 03 태그와 취향
// ─────────────────────────────────────────────

Table tags {
  tag_id     bigint      [pk, increment, note: '태그 식별자']
  name       varchar(20) [not null, unique, note: '속성 이름. 조용함·웨이팅 등 33개로 고정입니다. 이름에 정도를 넣지 않습니다']
  axis       tag_axis    [not null, note: '이 태그가 속한 5축 중 하나. 화면에서 묶어 보여 주는 기준입니다']
  high_label varchar(20) [not null, note: 'HIGH가 뜻하는 말. 맵기는 매움, 웨이팅은 김, 야외석은 있음입니다. AI 프롬프트와 화면에 그대로 씁니다']
  low_label  varchar(20) [not null, note: 'LOW가 뜻하는 말. 맵기는 순함, 웨이팅은 짧음, 야외석은 없음입니다']

  Note: '고정 사전 33행. HIGH와 LOW가 각 태그에서 무슨 뜻인지를 이 표가 정의합니다. 시드로만 채우고 런타임에 추가하지 않습니다'
}

Table review_tags {
  review_tag_id bigint     [pk, increment, note: '리뷰 태그 행 식별자']
  review_id     bigint     [not null, note: '태그를 뽑아낸 원본 리뷰. FK reviews.review_id']
  tag_id        bigint     [not null, note: '사전에서 매칭된 태그. FK tags.tag_id']
  fact_value    attr_level [note: '이 가게가 어느 쪽인가. 장소 쪽 집계로 그대로 들어갑니다. 문장에 근거가 없으면 NULL이고 그때는 장소 집계만 건너뜁니다']
  want_value    attr_level [note: '이 사람이 어느 쪽을 원하는가. 사람 쪽 집계로 그대로 들어갑니다. 뒤집거나 유도하지 않습니다']
  evidence_text text       [note: '그렇게 본 근거가 된 원문 조각. 요약하지 않고 그대로 잘라 옵니다. 짚을 곳이 없으면 NULL입니다']

  Indexes {
    (review_id, tag_id) [unique, name: 'uq_review_tags_pair']
    tag_id [name: 'ix_review_tags_tag']
  }

  Note: 'AI-1이 리뷰에서 뽑아낸 태그. 가게가 어떤가와 이 사람이 뭘 원하는가를 따로 받습니다. 두 집계 테이블은 여기서 전부 다시 계산할 수 있는 파생입니다'
}

Table place_tags {
  place_tag_id    bigint      [pk, increment, note: '장소 태그 집계 행 식별자']
  place_id        bigint      [not null, note: '집계 대상 장소. FK places.place_id']
  tag_id          bigint      [not null, note: '집계 대상 태그. FK tags.tag_id']
  fact_high_count integer     [not null, default: 0, note: 'HIGH라고 말한 사람 수. 사람 1명당 1표이고 그 사람의 최신 리뷰만 셉니다']
  fact_low_count  integer     [not null, default: 0, note: 'LOW라고 말한 사람 수. 둘을 더하면 이 태그를 말한 전체 인원이 됩니다']
  recomputed_at   timestamptz [not null, default: `now()`, note: '마지막으로 다시 센 시각. 더하지 않고 그 장소·그 태그를 통째로 다시 셉니다']

  Indexes {
    (place_id, tag_id) [unique, name: 'uq_place_tags_pair']
    tag_id [name: 'ix_place_tags_tag']
  }

  Note: '이 가게가 실제로 어떤가. 한 사람이 다섯 번 가서 다섯 번 맵다고 써도 그 집이 다섯 배 매워지지 않으므로 1인 1표입니다. 리뷰 수정·삭제에도 어긋나지 않도록 증분이 아니라 재계산합니다'
}

Table user_tags {
  user_tag_id     bigint      [pk, increment, note: '사용자 태그 집계 행 식별자']
  user_id         bigint      [not null, note: '취향의 주인. FK users.user_id']
  tag_id          bigint      [not null, note: '집계 대상 태그. FK tags.tag_id']
  want_high_count integer     [not null, default: 0, note: 'HIGH 쪽을 원한다고 말한 횟수. 리뷰마다 1표. 온보딩도 별도 경로가 아니라 첫 리뷰라 값이 전부 이 경로로만 들어옵니다']
  want_low_count  integer     [not null, default: 0, note: 'LOW 쪽을 원한다고 말한 횟수. 같은 말을 반복할수록 취향은 실제로 강해지므로 중복을 제거하지 않습니다']
  updated_at      timestamptz [not null, default: `now()`, note: '집계를 마지막으로 갱신한 시각']

  Indexes {
    (user_id, tag_id) [unique, name: 'uq_user_tags_pair']
    tag_id [name: 'ix_user_tags_tag']
  }

  Note: '이 사람이 어느 쪽을 원하는가. 만족했는가가 아니라 원하는 값을 셉니다. 두 사람의 우세 방향이 다르면 그것이 취향 갈림입니다. 온보딩도 리뷰(UC-04)라 값은 예외 없이 review_tags를 거쳐 들어옵니다'
}

Table unmatched_tag_logs {
  log_id     bigint      [pk, increment, note: '로그 행 식별자']
  review_id  bigint      [not null, note: '표현이 나온 리뷰. FK reviews.review_id']
  raw_tag    varchar(50) [not null, note: 'AI가 만들어 냈지만 사전 33개 밖이라 버린 이름']
  created_at timestamptz [not null, default: `now()`, note: '버린 시각. 기간별 미매칭률을 내는 기준입니다']

  Note: '버린 표현이 사전 미매칭률이 되어 PRD 14장 R2 착수 판단의 근거가 됩니다'
}

// ─────────────────────────────────────────────
// 04 추천
// ─────────────────────────────────────────────

Table place_similarity {
  place_similarity_id bigint       [pk, increment, note: '유사도 행 식별자']
  place_id            bigint       [not null, note: '기준 장소. FK places.place_id']
  similar_place_id    bigint       [not null, note: '비교 대상 장소. FK places.place_id']
  score               numeric(5,4) [not null, note: '피어슨 상관계수 -1.0000~1.0000. 두 장소를 함께 평가한 사람들의 평점으로 계산합니다']
  computed_at         timestamptz  [not null, default: `now()`, note: '이 값을 계산한 시각. 새벽 배치가 통째로 다시 씁니다']

  Indexes {
    (place_id, similar_place_id) [unique, name: 'uq_place_similarity_pair']
    (place_id, score) [name: 'ix_place_similarity_rank']
  }

  Note: '아이템 기반 협업 필터링의 사전 계산 결과. 추천 요청 때는 조회만 하고 계산하지 않습니다. 장소의 성격은 천천히 바뀌므로 하루 한 번 다시 계산해도 충분합니다. 3일 범위에서는 배치 대신 시드 스크립트가 한 번 채웁니다'
}

Table recommendation_requests {
  request_id           bigint      [pk, increment, note: '추천 요청 식별자. 결과 조회의 키입니다']
  group_id             bigint      [not null, note: '어느 그룹의 추천인가. FK relation_groups.group_id']
  requested_by_user_id bigint      [not null, note: '요청한 사람. FK users.user_id']
  query                text        [not null, note: '사용자가 쓴 한 줄 질의. 원문 그대로 남깁니다']
  intent_region        varchar(50) [note: '질의 해석 규칙이 읽어 낸 지역. 못 읽으면 NULL이고 그때는 되묻습니다']
  intent_count         smallint    [note: '질의 해석 규칙이 읽어 낸 개수. 없으면 기본 3입니다']
  intent_budget        smallint    [note: '질의 해석 규칙이 읽어 낸 예산 1~4. 언급이 없으면 NULL입니다']
  candidate_count      integer     [note: '알고리즘이 모은 후보 수. 시연에서 파이프라인 단계를 보여 주는 값입니다']
  cf_weight            numeric(3,2) [note: '이 요청에서 협업 필터링이 반영된 비중 0~1. w_cf(리뷰 수)로 계산합니다']
  status               rec_status  [not null, default: 'PENDING', note: '처리 상태. 화면은 PENDING이면 스켈레톤을 그립니다']
  created_at           timestamptz [not null, default: `now()`, note: '요청 시각']
  completed_at         timestamptz [note: '결과가 채워진 시각. PENDING 동안에는 NULL입니다']

  Indexes {
    (group_id, created_at) [name: 'ix_rec_requests_group']
    requested_by_user_id [name: 'ix_rec_requests_user']
  }

  Note: '추천 요청 한 건. 질의와 해석 결과를 함께 남겨 무엇을 어떻게 읽었는지 되짚을 수 있습니다'
}

Table recommendations {
  recommendation_id bigint      [pk, increment, note: '추천 결과 행 식별자']
  request_id        bigint      [not null, note: '어느 요청의 결과인가. FK recommendation_requests.request_id']
  place_id          bigint      [not null, note: '추천한 장소. 후보 목록 안의 값만 저장합니다. FK places.place_id']
  matched_tags      text[]      [note: '취향과 맞은 태그 이름들. tag_id로 조인하지 않고 그 시점의 이름을 굳혀 둡니다']
  basis             rec_basis   [not null, note: '우리 기록인가 남의 기록인가. SQL이 정해 실어 보냈다 되받은 값입니다']
  reason            text        [not null, note: 'AI-2가 쓴 이유 문장. 두 문장 이내입니다. 알고리즘이 고른 장소를 설명만 합니다']
  display_order     smallint    [not null, note: '화면에 보여 줄 순서. 협업 필터링과 태그 매칭을 가중 결합한 알고리즘이 매긴 순서입니다']

  Indexes {
    (request_id, place_id) [unique, name: 'uq_recommendations_pair']
    (request_id, display_order) [name: 'ix_recommendations_order']
  }

  Note: '추천 결과 한 줄. 그 시점의 판단을 굳힌 스냅샷이라 사전이 바뀌어도 과거 추천의 이유가 흔들리지 않습니다'
}

// ─────────────────────────────────────────────
// 05 월간 리포트 (유료)
// ─────────────────────────────────────────────

Table monthly_reports {
  report_id            bigint        [pk, increment, note: '리포트 식별자. 열람 조회의 키입니다']
  group_id             bigint        [not null, note: '어느 그룹의 리포트인가. 리포트의 주인은 사람이 아니라 그룹입니다. FK relation_groups.group_id']
  report_month         date          [not null, note: '대상 달. 해당 월 1일로 저장합니다. 월 경계는 그룹 시간대 Asia/Seoul 기준 1일 00:00~말일 23:59:59입니다']
  status               report_status [not null, default: 'PENDING', note: '생성 상태. 화면은 PENDING이면 스켈레톤, FAILED면 재시도 버튼을 그립니다. D-14의 예외로 둔 상태 컬럼입니다']
  model                varchar(50)   [note: '문장을 쓴 모델명. gpt-4o-mini 등 설정값이 그대로 들어갑니다. 템플릿 라이터면 TEMPLATE. 나중에 모델을 바꿔도 과거 리포트가 무엇으로 쓰였는지 남습니다']
  prompt_tokens        integer       [note: '응답 usage의 입력 토큰 실측값. 리포트 1건 원가 계산의 근거입니다. PENDING·FAILED 동안 NULL']
  completion_tokens    integer       [note: '응답 usage의 출력 토큰 실측값. 위와 같은 용도입니다']
  content              jsonb         [note: '리포트 본문. title·summary·highlights·tasteShift·splitTags·nextMonth·closingLine·meta. 출력 스키마가 고정이라 컬럼으로 펼치지 않습니다. PENDING이면 NULL, FAILED면 meta.error만 들어갑니다']
  requested_by_user_id bigint        [not null, note: '생성을 누른 사람. 리포트는 그룹 것이지만 누가 요청했는지는 남깁니다. FK users.user_id']
  created_at           timestamptz   [not null, default: `now()`, note: '요청 시각']
  completed_at         timestamptz   [note: '검증을 통과해 저장된 시각. PENDING·FAILED 동안 NULL. 재시도로 성공하면 그때 채웁니다']

  Indexes {
    (group_id, report_month) [unique, name: 'uq_monthly_reports_month']
    (group_id, created_at) [name: 'ix_monthly_reports_group']
  }

  Note: '그룹의 한 달 리포트 한 편. UQ가 월 1회를 강제하고 409의 근거가 됩니다. 저장하는 이유는 유료 재생성 비용입니다. 실패한 리포트는 삭제하지 않고 같은 행을 재시도로 갱신하므로 UQ와 충돌하지 않습니다'
}

Table subscriptions {
  subscription_id bigint      [pk, increment, note: '구독 행 식별자']
  group_id        bigint      [not null, note: '구독 주체 그룹. 한 명이 결제하면 구성원 모두가 PREMIUM입니다. FK relation_groups.group_id']
  plan            varchar(10) [not null, note: '이 구독으로 전환된 플랜. 지금은 PREMIUM만 들어옵니다']
  started_at      timestamptz [not null, default: `now()`, note: '유료가 시작된 시각. 환불·분쟁에서 언제부터였는지를 답하는 값입니다']
  ended_at        timestamptz [note: '해지·만료 시각. NULL이면 유효한 구독입니다. 정기 결제와 만료 처리는 R8이고 지금은 이 값을 채우는 경로가 없습니다']
  payment_ref     varchar(64) [note: '결제 참조 번호. 3일 범위에서는 PaymentClient Mock이 만든 승인 번호가 들어갑니다. 실제 PG로 바꾸면 PG 거래 ID가 들어오고 컬럼은 그대로입니다']

  Indexes {
    (group_id, started_at) [name: 'ix_subscriptions_group']
  }

  Note: 'Mock 결제 기록. relation_groups.plan이 현재 값이고 이 테이블이 이력입니다. 테이블을 두는 이유는 언제부터 유료였는지가 없으면 환불·분쟁 대응이 불가하기 때문입니다. 결제 연동은 비목표라 PaymentClient 인터페이스 뒤 Mock이 씁니다'
}

// ─────────────────────────────────────────────
// 관계
// ─────────────────────────────────────────────

// 그룹 구성원: 사용자와 그룹의 N대N
Ref: group_members.group_id > relation_groups.group_id
Ref: group_members.user_id > users.user_id

// 초대: 그룹을 먼저 만들고 코드를 발급합니다
Ref: invite_codes.group_id > relation_groups.group_id
Ref: invite_codes.inviter_user_id > users.user_id

// 리뷰: 개인이 장소에 남깁니다
Ref: reviews.user_id > users.user_id
Ref: reviews.place_id > places.place_id
Ref: reviews.with_group_id > relation_groups.group_id

// 그룹 지도: 그룹이 담은 장소와 담은 사람
Ref: group_places.group_id > relation_groups.group_id
Ref: group_places.place_id > places.place_id
Ref: group_places.added_by_user_id > users.user_id

// 태그 추출 결과: 모든 집계의 원본
Ref: review_tags.review_id > reviews.review_id
Ref: review_tags.tag_id > tags.tag_id

// 장소 쪽 집계 캐시 - 사실(HIGH/LOW)을 셉니다
Ref: place_tags.place_id > places.place_id
Ref: place_tags.tag_id > tags.tag_id

// 사람 쪽 집계 캐시 - 원하는 값(HIGH/LOW)을 셉니다
Ref: user_tags.user_id > users.user_id
Ref: user_tags.tag_id > tags.tag_id

// 사전 밖 표현 로그
Ref: unmatched_tag_logs.review_id > reviews.review_id

// 협업 필터링 사전 계산 - 장소 대 장소
Ref: place_similarity.place_id > places.place_id
Ref: place_similarity.similar_place_id > places.place_id

// 추천: 요청 하나에 결과 여러 줄
Ref: recommendation_requests.group_id > relation_groups.group_id
Ref: recommendation_requests.requested_by_user_id > users.user_id
Ref: recommendations.request_id > recommendation_requests.request_id
Ref: recommendations.place_id > places.place_id

// 월간 리포트: 그룹에 한 달 한 편. 요청자는 남기되 주인은 그룹
Ref: monthly_reports.group_id > relation_groups.group_id
Ref: monthly_reports.requested_by_user_id > users.user_id

// 구독: 그룹 단위 Mock 결제 이력
Ref: subscriptions.group_id > relation_groups.group_id

// ─────────────────────────────────────────────
// 다이어그램 구획
// ─────────────────────────────────────────────

TableGroup g01_users_groups {
  users
  relation_groups
  group_members
  invite_codes
}

TableGroup g02_places_reviews {
  places
  reviews
  group_places
}

TableGroup g04_recommendation {
  place_similarity
  recommendation_requests
  recommendations
}

TableGroup g03_tags_taste {
  tags
  review_tags
  place_tags
  user_tags
  unmatched_tag_logs
}

TableGroup g05_report {
  monthly_reports
  subscriptions
}
