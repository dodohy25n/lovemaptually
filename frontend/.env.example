# ─────────────────────────────────────────────
# Love Maptually · frontend 환경 변수 예시
# 이 파일은 커밋합니다. 실제 값이 담긴 .env / .env.local 은 절대 커밋하지 마세요.
#
# ⚠️ VITE_ 접두어가 붙은 값은 모두 브라우저 번들에 그대로 포함되어
#    사용자에게 공개됩니다. 서버 전용 비밀 키(REST API Key, Secret,
#    토큰 등)는 어떤 경우에도 여기에 넣지 마세요.
# ─────────────────────────────────────────────

# 데이터 소스: local(localStorage) | api(백엔드 연동, 아직 미구현)
VITE_DATA_MODE=local

# 카카오 JavaScript 키 — 지도와 가게 검색이 함께 씁니다 (비워두면 둘 다 대체 경로로 동작)
#
#   ⚠️ 반드시 'JavaScript 키'여야 합니다. REST API 키를 넣지 마세요.
#      카카오 콘솔 > 내 애플리케이션 > 앱 키 에서 JavaScript 키를 복사하고,
#      플랫폼 > Web 에 사이트 도메인(http://localhost:5173 등)을 반드시 등록하세요.
#      도메인 제한이 없으면 번들에서 키를 복사해 그대로 도용할 수 있습니다.
VITE_KAKAO_JS_KEY=

# 챗봇 응답: mock(정해진 mock 응답) | api(실제 AI 백엔드, 아직 미구현)
VITE_AI_MODE=mock

# Postman Mock Server base URL
VITE_API_BASE_URL=https://eb065d73-185a-4912-8c34-fe7f0896e97b.mock.pstmn.io

# ─────────────────────────────────────────────
# 여기에 두면 안 되는 것
#
# KAKAO_REST_API_KEY 는 **서버 전용**이라 프론트엔드에 두지 않습니다.
#   · VITE_ 접두어 없이 두면 → 브라우저 코드가 읽을 수 없어 아무 소용이 없고,
#   · VITE_ 를 붙이면      → 번들에 그대로 박혀 누구나 꺼내 쓸 수 있습니다.
# REST 키는 backend 의 환경 변수로 옮기고, 장소 검색이 서버를 거치게 되면
# 그때 백엔드에서 사용하세요. 프론트엔드에서는 위의 VITE_KAKAO_JS_KEY 를 씁니다.
# ─────────────────────────────────────────────
